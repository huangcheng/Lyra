# Lyra environment — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.

# Master key for the per-user credential-encryption hierarchy (required, 32+ bytes).
# All stored mail-account passwords and TOTP secrets are encrypted under keys
# derived from this value. Losing it makes stored credentials unrecoverable.
# Generate with:
#   openssl rand -base64 32
LYRA_MASTER_KEY=

# Public URL for this Lyra instance (required, no trailing slash).
# Must match what users type in the browser. OAuth redirect URI is derived from this.
# Examples:
#   http://localhost:3000
#   https://mail.example.com
LYRA_PUBLIC_URL=http://localhost:3000

# Optional: login/bootstrap captcha. Off by default.
# Provider: turnstile (Cloudflare), hcaptcha, recaptcha (Google v2 checkbox),
# or recaptcha-v3 (Google v3, invisible + score-based).
# The host must reach the provider's verify API (LAN-only / offline installs: leave unset).
# Can also be configured at runtime in Settings → General → Login Captcha;
# a saved setting overrides these env vars.
# LYRA_CAPTCHA_PROVIDER=turnstile
# LYRA_CAPTCHA_SITE_KEY=
# LYRA_CAPTCHA_SECRET=

# Optional: Microsoft Outlook / M365 mail-account OAuth (authorization code + PKCE).
# Register a public or confidential app in Entra ID. Shared redirect URI (auto-derived):
#   {LYRA_PUBLIC_URL}/api/v1/oauth/callback
# Start flow: GET /api/v1/oauth/start?email=user@live.in
# LYRA_MS_OAUTH_CLIENT_ID=
# LYRA_MS_OAUTH_CLIENT_SECRET=
# LYRA_MS_OAUTH_TENANT=common

# Web Push (RFC 8292) contact claim, shown to push services (Google/Mozilla/
# Apple) for abuse reports. Defaults to mailto:admin@<LYRA_PUBLIC_URL host>.
# LYRA_VAPID_SUBJECT=mailto:admin@example.com
# NOTE: background push requires REDIS_URL (the kv store) — with the default
# in-memory kv the VAPID key regenerates on every restart and existing browser
# subscriptions stop working until push is toggled off/on in Settings.

# ── Sentry error reporting (opt-in, unset = fully disabled) ─────────────
# Backend (Rust) project DSN. Initialized before DB/migrations so boot
# crashes are reported too.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Frontend (React) project DSN — advertised to the SPA via /version.
# Falls back to SENTRY_DSN when unset (single-project setups).
# SENTRY_FRONTEND_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Trace sample rate for the backend, 0.0-1.0 (default 0.0 = errors only).
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── OpenTelemetry tracing (opt-in, unset = disabled) ────────────────────
# Any OTLP/HTTP receiver works. For Sentry: Project Settings → Client Keys
# → OpenTelemetry tab, and pair with the auth header below.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://o<orgId>.ingest.<region>.sentry.io/api/<projectId>/integration/otlp/v1/traces
# Receiver auth headers, `k=v,k=v` — Sentry uses the DSN public key:
# OTEL_EXPORTER_OTLP_HEADERS=x-sentry-auth=Sentry sentry_key=<public-key>, sentry_version=7
# OTEL_TRACES_SAMPLE_RATIO=1.0
# OTEL_SERVICE_NAME=lyra-backend
