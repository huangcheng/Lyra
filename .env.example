# Lyra environment — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.

# Master key for the per-user credential-encryption hierarchy (required, 32+ bytes).
# All stored mail-account passwords and TOTP secrets are encrypted under keys
# derived from this value. Losing it makes stored credentials unrecoverable.
# Generate with:
#   openssl rand -base64 32
LYRA_MASTER_KEY=

# Public URL for this Lyra instance (required, no trailing slash).
# Must match what users type in the browser. OAuth redirect URI is derived from this.
# Examples:
#   http://localhost:3000
#   https://mail.example.com
LYRA_PUBLIC_URL=http://localhost:3000

# Optional: Microsoft Outlook / M365 mail-account OAuth (authorization code + PKCE).
# Register a public or confidential app in Entra ID. Shared redirect URI (auto-derived):
#   {LYRA_PUBLIC_URL}/api/v1/oauth/callback
# Start flow: GET /api/v1/oauth/start?email=user@live.in
# LYRA_MS_OAUTH_CLIENT_ID=
# LYRA_MS_OAUTH_CLIENT_SECRET=
# LYRA_MS_OAUTH_TENANT=common
